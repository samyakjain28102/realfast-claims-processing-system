# Copy to `.env` in the project root and adjust values.
# Loaded automatically when you run the API or seed loader (see app/env.py).

# SQLite database file path.
# Use the same value for seeding and for the API, or the API will not see seeded data.
# If unset: API uses :memory: (empty, non-persistent); seed loader defaults to claims.db.
CLAIMS_DATABASE=claims.db

# Google Gemini API key — only for unstructured claim extraction (GeminiClaimExtractor).
# Core adjudication, the REST API, and pytest do not require this.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
